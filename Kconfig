menuconfig ZPERF
    bool "zperf runtime analyzer"
    select LOG
    select THREAD_MONITOR
    select THREAD_NAME
    select TRACING
    help
      Enable the zperf runtime analyzer tool and its Zephyr tracing hooks.

# zperf runs from the TRACING_USER hooks. TRACING_USER is a member of a choice, which
# 'select' cannot set, so make it the default tracing format instead. Module Kconfig is
# sourced before subsys/tracing, so this default takes precedence over TRACING_NONE.
choice TRACING_FORMAT_CHOICE
    default TRACING_USER if ZPERF
endchoice

if ZPERF

choice ZPERF_TIMESTAMP_SOURCE
    prompt "Timestamp source"
    default ZPERF_TIMESTAMP_TIMING_FUNCTIONS
    help
      Clock zperf uses to time threads.

config ZPERF_TIMESTAMP_TIMING_FUNCTIONS
    bool "Cycle counter (timing functions)"
    select TIMING_FUNCTIONS
    help
      Use the cycle counter of the Zephyr timing functions (DWT CYCCNT on Cortex-M) for
      microsecond resolution. The counter may stop while the CPU sleeps, so zperf keeps it in
      step with the kernel tick clock: time is measured at counter resolution while the CPU
      runs, and at tick resolution across sleep.

config ZPERF_TIMESTAMP_UPTIME_TICKS
    bool "Kernel uptime ticks"
    help
      Use k_uptime_ticks() only. Resolution is one system tick
      (1 / CONFIG_SYS_CLOCK_TICKS_PER_SEC, about 30.5 us on nRF52).

endchoice

config ZPERF_TRACE_MAIN_STAT
    bool "Trace per-cycle thread runtime statistics"
    default y

config ZPERF_TRACE_UPTIME
    bool "Trace uptime statistics"
    default y

config ZPERF_TRACE_HISTORY
    bool "Trace collected hook history"
    default n

config ZPERF_TRACE_CPU_LOAD
    bool "Trace CPU load statistics"
    default y

config ZPERF_RTOS_HAS_SYSTEM_TASKS
    bool "Account for RTOS-created system threads"
    default y

config ZPERF_USER_TASKS_COUNT
    int "Number of application threads"
    default 3
    range 0 255

config ZPERF_SYSTEM_TASKS_COUNT
    int "Number of RTOS/system threads"
    default 5
    range 0 255
    depends on ZPERF_RTOS_HAS_SYSTEM_TASKS

config ZPERF_ISR_RUNTIME_SUPPORTED
    bool "Enable ISR runtime accounting"
    default y

config ZPERF_ISR_RUNTIME_DISTINGUISH
    bool "Distinguish individual ISRs"
    default n

config ZPERF_ISR_TOTAL_RUNTIME_ONLY
    bool "Measure total ISR runtime only"
    default y

config ZPERF_RTOS_HAS_IDLE_SWITCHES
    bool "RTOS exposes idle enter/exit switches"
    default n

config ZPERF_HISTORY_SIZE
    int "Hook history size"
    default 25
    range 1 1024

config ZPERF_CPU_USAGE_THRESHOLD
    int "CPU usage warning threshold"
    default 50
    range 0 100

endif
